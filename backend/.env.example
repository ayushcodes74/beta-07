# Module 1 (auth): Supabase access-token verification.
# Values must come from the Supabase project's confirmed JWT configuration.
# Never commit real values. While incomplete, protected routes return 503.

# "jwks" (asymmetric signing keys) or "shared_secret" (legacy HS* secret)
SUPABASE_JWT_VERIFICATION_METHOD=
# Required when the method is "jwks"
SUPABASE_JWKS_URL=
# Required when the method is "shared_secret" (backend-only secret)
SUPABASE_JWT_SECRET=
# Comma-separated allow-list of signing algorithms
SUPABASE_JWT_ALGORITHMS=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
