# OpenRouter (primary provider). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Extra OpenRouter models tried in order before falling back to Gemini.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# Model "thinking": off (fastest; ~5x quicker here) | low | medium | high | default
OPENROUTER_REASONING=off

# Google Gemini (backup provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Extra Gemini models tried in order if the primary fails. Free-tier quotas are per model.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Fallback chain. Providers without an API key are skipped automatically.
LLM_PROVIDER_ORDER=openrouter,gemini
LLM_RETRIES_PER_PROVIDER=1
LLM_REQUEST_TIMEOUT=90
LLM_RATE_LIMIT_COOLDOWN_SECONDS=300
LLM_QUOTA_EXHAUSTED_COOLDOWN_SECONDS=1800

# Generation settings
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT=30.0

# Optional overrides
ENVIRONMENT=development
