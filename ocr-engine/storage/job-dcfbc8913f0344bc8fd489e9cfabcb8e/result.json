^2 + 5)^3$$","combined_latex":"f'(x) = \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h}\n\\frac{d}{dx} x^n = nx^{n-1}\n\\frac{d}{dx} (C) = 0\n\\frac{d}{dx} [f(x) \\pm g(x)] = f'(x) + g'(x)\n\\frac{dy}{dx} = f'(g(x)) \\cdot g'(x)\ny = (3x^2 + 5)^4\n\\frac{dy}{dx} = 4(3x^2 + 5)^3 \\times 6x\n\\frac{dy}{dx} = 24x (3x^2 + 5)^3","warnings":["Page appears sideways (vertical text lines detected). Flagged for review; OCR verification required."],"metadata":{"contrast_score":52.18,"orientation_corrected":false,"skew_detected":2.26,"math_regions_count":8,"text_blocks_count":18,"languages":["en"],"content_types":{"text":10,"math":8}}},{"page_id":"page-2","page_number":2,"status":"completed","width":1654,"height":2339,"image_path":"storage/job-dcfbc8913f0344bc8fd489e9cfabcb8e/artifacts/a7c53cfc-c9c7-4ce3-8295-186c8fb29642/pages/page_002.png","enhanced_image_path":"storage/job-dcfbc8913f0344bc8fd489e9cfabcb8e/artifacts/a7c53cfc-c9c7-4ce3-8295-186c8fb29642/enhanced/page_002.png","text_blocks":[{"block_id":"page-2-block-1","sequence":1,"type":"handwritten","text":"03","confidence":null,"quality_score":0.28,"bounding_box":{"x1":103,"y1":229,"x2":151,"y2":264},"warnings":["Faint or low-contrast text strokes detected."],"metadata":{"engine_used":"gemini-vision","model_version":"gemini-vision:gemini-2.5-flash","is_fallback":false,"recognition_mode":"vision_llm","recognition_available":true,"device":"cloud","content_type":"text","language":"en","uncertain":false}},{"block_id":"page-2-block-2","sequence":2,"type":"handwritten","text":"Ans","confidence":null,"quality_score":0.95,"bounding_box":{"x1":103,"y1":274,"x2":162,"y2":309},"warnings":[],"metadata":{"engine_used":"gemini-vision","model_version":"gemini-vision:gemini-2.5-flash","is_fallback":false,"recognition_mode":"vision_llm","recognition_available":true,"device":"cloud","content_type":"text","language":"en","uncertain":false}},{"block_id":"page-2-block-3","sequence":3,"type":"handwritten","text":"Differentiability, Continuity and mean